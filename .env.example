QWEN_START_COMMAND=ssh btechuser@10.240.166.9 "fuser -k 8001/tcp || true; nohup bash -lc 'source ~/venv-qwen35-student/bin/activate && QWEN35_MODEL_PATH=/home/btechuser/models/Qwen3.5-4B QWEN35_SERVED_MODEL_NAME=Qwen/Qwen3.5-4B QWEN35_STUDENT_DEVICE=cuda exec uvicorn qwen35_student_server:app --host 0.0.0.0 --port 8001' > ~/qwen35-4b-server.log 2>&1 < /dev/null &"
QWEN_STUDENT_START_COMMAND=ssh btechuser@10.240.166.9 "fuser -k 8004/tcp || true; nohup bash -lc 'source ~/venv-qwen35-student/bin/activate && QWEN35_STUDENT_DEVICE=cpu exec uvicorn qwen35_student_server:app --host 0.0.0.0 --port 8004' > ~/qwen35-2b-server.log 2>&1 < /dev/null &"
GEMMA_START_COMMAND=ssh -N -L 11435:127.0.0.1:11434 btechuser@10.240.166.9
